{
  "name": "automation-platform-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "All Automation Platform UIs (dashboard, load testing, API testing, Rewind) with one set of dependencies.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -n shell,load-testing,api-testing,ui-automation -c green,magenta,cyan,yellow \"npm:dev:shell\" \"npm:dev:load-testing\" \"npm:dev:api-testing\" \"npm:dev:ui-automation\"",
    "dev:shell": "vite",
    "dev:load-testing": "vite src/components/load-testing",
    "dev:api-testing": "vite src/components/api-testing",
    "dev:ui-automation": "vite src/components/ui-automation",
    "build": "npm run build:shell && npm run build:load-testing && npm run build:api-testing && npm run build:ui-automation",
    "build:shell": "tsc -b && vite build",
    "build:load-testing": "tsc -b src/components/load-testing && vite build src/components/load-testing",
    "build:api-testing": "tsc -b src/components/api-testing && vite build src/components/api-testing",
    "build:ui-automation": "tsc -p src/components/ui-automation && vite build src/components/ui-automation",
    "typecheck": "tsc -b && tsc -b src/components/load-testing src/components/api-testing && tsc -p src/components/ui-automation",
    "test": "vitest run --root src/components/load-testing && vitest run --root src/components/api-testing",
    "lint": "oxlint && npm run lint:load-testing",
    "lint:load-testing": "cd src/components/load-testing && eslint . --max-warnings 0",
    "format": "cd src/components/load-testing && prettier --write .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "axios": "^1.6.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.4.32",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.3.3",
    "tailwindcss-v3": "npm:tailwindcss@^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
